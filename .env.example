# Copia este archivo a ".env" y ajusta los valores. NUNCA subas .env al repositorio.
# Todos los valores son de EJEMPLO.

# --- PostgreSQL ---
POSTGRES_DB=usuarios_roles
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-esta-password

# --- JWT ---
# Clave HMAC-SHA256 de mínimo 32 caracteres. Genera una propia, por ejemplo:
#   openssl rand -base64 48
JWT_KEY=EJEMPLO-reemplaza-por-una-clave-aleatoria-de-32+bytes
JWT_ACCESS_TOKEN_MINUTES=15

# --- Cookie del refresh token ---
# false solo para la demo local en http://localhost. Con HTTPS en producción: true.
AUTH_COOKIE_SECURE=false

# --- URLs ---
FRONTEND_BASE_URL=http://localhost:8080

# --- Funcionalidades ---
# Buzón de desarrollo (correos simulados visibles en /dev/buzon). false en producción.
DEV_MAILBOX=true
# Documentación OpenAPI + Scalar en /scalar.
OPENAPI_ENABLED=true
# Usuarios demo ficticios admin@demo.pe y usuario@demo.pe (Demo123!). false en producción.
SEED_DEMO_USERS=true
# Intentos por minuto y por IP en login/registro/recuperación.
AUTH_RATE_LIMIT=10
