{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Postgres"
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=usuarios_roles;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "usuarios-roles-base",
    "Audience": "usuarios-roles-base-clients",
    "Key": "",
    "AccessTokenMinutes": 15
  },
  "AuthCookie": {
    "Name": "urb_refresh",
    "Secure": true
  },
  "Security": {
    "Password": {
      "MinLength": 8,
      "MaxLength": 128,
      "RequireUppercase": true,
      "RequireLowercase": true,
      "RequireDigit": true,
      "RequireSymbol": true,
      "ForbidEmailInPassword": true
    },
    "Lockout": {
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 15
    },
    "Tokens": {
      "RefreshTokenDays": 7,
      "EmailVerificationHours": 24,
      "PasswordResetMinutes": 30
    }
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60
  },
  "AppUrls": {
    "FrontendBaseUrl": "http://localhost:5173"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "TrustAllProxies": false
  },
  "Features": {
    "DevMailbox": false
  },
  "OpenApi": {
    "Enabled": false
  },
  "Seed": {
    "DemoUsers": true,
    "DemoPassword": "Demo123!"
  }
}
