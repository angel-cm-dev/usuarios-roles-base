<Project>
  <!-- Propiedades comunes a todos los proyectos de la solución. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Authors>Angel Castañeda Meza</Authors>
    <Company>angel-cm-dev</Company>
    <Product>usuarios-roles-base</Product>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>
